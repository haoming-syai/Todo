# Next Auth — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Prisma + Supabase Postgres
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase Storage (public bucket) + Realtime — anon key only
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
